# App
DEEVO_APP_NAME=Deevo MT Framework
DEEVO_DEBUG=true
DEEVO_ENVIRONMENT=development

# Database (SQL Server via pyodbc — requires ODBC Driver 17 or 18 on the host)
# Runtime user should be deevo_app (read/write, no DDL). Use deevo_ddl only for migrations.
# Alternative single URL (SQLAlchemy mssql+pyodbc dialect):
# DATABASE_URL=mssql+pyodbc://deevo_app:change-me@localhost:1433/deevo_mt?driver=ODBC+Driver+17+for+SQL+Server

DEEVO_MSSQL_SERVER=localhost
DEEVO_MSSQL_PORT=1433
DEEVO_MSSQL_DATABASE=deevo_mt
DEEVO_MSSQL_USER=deevo_app
DEEVO_MSSQL_PASSWORD=change-me
DEEVO_MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
DEEVO_MSSQL_URL_MINIMAL=true
# Local dev only. Production refuses to start unless traffic is encrypted AND the server
# certificate is verified (it always sends Encrypt=yes;TrustServerCertificate=no — note
# ODBC Driver 17 does *not* encrypt unless told to). Same rules apply to DEEVO_DATABASE_URL.
DEEVO_MSSQL_TRUST_SERVER_CERTIFICATE=true

# JWT
# At least 32 bytes for HS256 (48 for HS384, 64 for HS512); production refuses to start
# with a placeholder or shorter secret. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DEEVO_JWT_SECRET_KEY=change-me
# HS256 | HS384 | HS512
DEEVO_JWT_ALGORITHM=HS256
DEEVO_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
DEEVO_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Mailbox OAuth — page the browser lands on after a successful Microsoft consent
# (must be https:// when DEEVO_ENVIRONMENT=production)
DEEVO_MAILBOX_OAUTH_SUCCESS_URL=http://localhost:8001/verification

# Login throttling (in memory, per worker process; defaults shown)
# DEEVO_LOGIN_MAX_FAILURES_PER_ACCOUNT_IP=5   # wrong passwords for one account from one IP → 429
# DEEVO_LOGIN_MAX_FAILURES_PER_IP=30          # wrong passwords from one IP, any accounts → 429
# DEEVO_LOGIN_FAILURE_WINDOW_SECONDS=900
# DEEVO_LOGIN_ACCOUNT_LOCKOUT_THRESHOLD=50    # account-wide lock, all IPs combined
# DEEVO_LOGIN_ACCOUNT_LOCKOUT_MINUTES=15
# Reverse proxies whose X-Forwarded-For is trusted (JSON list of IPs/CIDRs). Leave empty
# unless the app runs behind a proxy/load balancer — otherwise clients could spoof their IP.
DEEVO_TRUSTED_PROXIES=[]

# CORS (JSON array). Each entry exactly scheme://host[:port] — no path or trailing "/".
# Production: https only, never "*" or "null" (the app refuses to start otherwise).
DEEVO_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8501","http://localhost:8502"]
# Auth is Bearer-only (no cookies); set false unless a client sends withCredentials.
# DEEVO_CORS_ALLOW_CREDENTIALS=true

# Tests — set to 1 to skip integration tests that need a live SQL Server
DEEVO_SKIP_DB_TESTS=0
